{
  "upstream_base_url": "https://integrate.api.nvidia.com/",
  "upstream_api_key":  "your-nvapi-key-here",
  "request_timeout_secs": 600,
  "max_request_body_bytes": 33554432,

  "system_message_placement": "inline",

  "forward_documents": false,

  "reasoning": {
    "default": "none",
    "models": {
      "gpt-5.4-mini": "high",
      "gpt-5.6-luna":  "medium"
    },

    "effort_map": {
      "default": {
        "low": "none",
        "medium": "low",
        "high": "medium",
        "xhigh": "high",
        "max": "high"
      },
      "models": {
        "gpt-5.6-luna": {
          "low": "low",
          "medium": "medium",
          "high": "high",
          "xhigh": "xhigh",
          "max": "max"
        }
      }
    },

    "thinking_disabled": {
      "default": {
        "disabled": "none"
      }
    }
  },

  "model_aliases": {
    "default_model": "gpt-4o-mini",
    "map": {
      "claude-opus-4-8":  "gpt-5.6-luna",
      "claude-sonnet-5":  "gpt-5.4-mini",
      "claude-haiku-4-5": "gpt-4o-mini"
    }
  },

  "prompt_caching": {
    "models": ["gpt-5.6-luna", "gpt-5.6-terra", "gpt-5.6-sol"],
    "cache_key": "my-app"
  },

  "advisor": {
    "enabled": false,
    "model": "beam",
    "effort": "medium",
    "max_uses": 2,
    "max_tokens": 4096,
    "reasoning_max_tokens": 16384,
    "timeout_secs": 0
  },

  "web_fetch": {
    "enabled": false,
    "timeout_secs": 20,
    "max_bytes": null,
    "max_content_bytes": null
  },

  "web_search": {
    "enabled": false,
    "compaction_model": null,
    "compaction_threshold_chars": 5000,
    "max_queries": 3,
    "max_results_per_query": 5,
    "state_dir": "proxy-state",
    "cache_ttl_secs": 600,
    "cache_max_entries": 128,
    "session_ttl_hours": 168
  },

  "server_tools": {
    "max_rounds": 10,
    "pause_turn": false
  }
}
